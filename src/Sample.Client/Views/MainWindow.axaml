<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sample.Client.ViewModels"
        xmlns:avm="using:Sample.App.ViewModels"
        xmlns:v="using:Sample.App.Views"
        x:Class="Sample.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Реплікація: клієнт" Width="900" Height="1000">
  <Grid RowDefinitions="Auto,*,5,200">
    <TextBlock Grid.Row="0" Margin="8,4" Text="{Binding State}" Classes="muted" />
    <Grid Grid.Row="1" ColumnDefinitions="280,5,*">
      <!-- owners: always visible, new ones are added here -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="Власник (URL):" />
            <TextBox Text="{Binding Url}" PlaceholderText="http://host:5005" />
            <TextBlock Text="Назва:" />
            <TextBox Text="{Binding OwnerName}" />
            <Button HorizontalAlignment="Stretch" Content="Додати власника і почати реплікацію" Command="{Binding AddOwnerCommand}" />
            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h" Text="Власники" Margin="0,0,0,4" />
          <ListBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="avm:ClientPanelViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <!-- views of the selected owner; a hint while there is none -->
      <Panel Grid.Column="2">
        <TextBlock Text="Додайте власника зліва, щоб побачити його дані" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding SelectedOwner, Converter={x:Static ObjectConverters.IsNull}}" />
        <ScrollViewer IsVisible="{Binding SelectedOwner, Converter={x:Static ObjectConverters.IsNotNull}}">
          <v:ClientPanel DataContext="{Binding SelectedOwner}" />
        </ScrollViewer>
      </Panel>
    </Grid>
    <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
    <v:LogView Grid.Row="3" DataContext="{Binding Feed}" />
  </Grid>
</Window>
